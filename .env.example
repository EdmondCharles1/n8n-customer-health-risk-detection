# Copy this file to .env and fill in a real encryption key.
#   Copy-Item .env.example .env
#
# .env is git-ignored and must NEVER be committed.

# Timezone used by the container and by n8n cron/schedule nodes
TZ=America/Port-au-Prince
GENERIC_TIMEZONE=America/Port-au-Prince

# Key used by n8n to encrypt stored credentials.
# Generate a long random value, for example in PowerShell:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }))
# Keep it safe: losing it makes every stored credential unreadable.
N8N_ENCRYPTION_KEY=CHANGE_ME_WITH_A_LONG_RANDOM_VALUE
