# Server-only URL. Use an HTTPS production Webhook URL on Vercel.
N8N_WEBHOOK_URL=http://localhost:5678/webhook/customer-risk-analysis

# Server-only value. It must exactly match the Header Auth credential attached
# to the n8n Webhook node. Never prefix it with NEXT_PUBLIC_.
N8N_WEBHOOK_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
